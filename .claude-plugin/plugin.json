{
	"name": "sentinel",
	"description": "General development workflows for typescript projects, including linting with eslint_d and more",
	"version": "1.5.3",
	"author": {
		"name": "Christopher Buss",
		"email": "christopher.buss@pm.me",
		"url": "https://github.com/christopher-buss"
	},
	"homepage": "https://github.com/christopher-buss/skills",
	"repository": "https://github.com/christopher-buss/skills",
	"license": "MIT",
	"keywords": ["tdd", "typescript", "collaboration", "best-practices", "workflows"],
	"skills": "./no-op/",
	"outputStyles": "./output-styles/",
	"lspServers": {
		"typescript": {
			"command": "typescript-language-server",
			"args": ["--stdio"],
			"diagnostics": false,
			"extensionToLanguage": {
				".cjs": "javascript",
				".cts": "typescript",
				".js": "javascript",
				".jsx": "javascriptreact",
				".mjs": "javascript",
				".mts": "typescript",
				".ts": "typescript",
				".tsx": "typescriptreact"
			}
		}
	}
}
