{
	"compilerOptions": {
		"target": "es2023",
		"jsx": "react",
		"jsxFactory": "h",
		"jsxFragmentFactory": "Fragment",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": [],
		"allowImportingTsExtensions": true,
		"strict": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [".claude-plugin/types", "hooks", "src", "tests"]
}
